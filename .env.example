# Copia este archivo a .env y ajusta los valores para tu entorno.
# .env está en .gitignore: nunca subas credenciales reales al repo.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=demokyros
DB_USERNAME=demokyros
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Genera un valor aleatorio de al menos 32 bytes para producción (ej: openssl rand -base64 32)
JWT_SECRET=change-me-min-32-bytes-random-secret
JWT_EXPIRATION_MINUTES=720

# '*' permite cualquier origen (solo dev). En prod, lista separada por comas: https://miapp.com,https://admin.miapp.com
CORS_ALLOWED_ORIGINS=*
